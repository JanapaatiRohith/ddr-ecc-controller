###############################################################################
# Created by write_sdc
###############################################################################
current_design ddr_controller
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk -period 10.0000 [get_ports {clk}]
set_propagated_clock [get_clocks {clk}]
set_input_delay 1.0000 -clock [get_clocks {clk}] -add_delay [get_ports {req_valid}]
set_input_delay 1.0000 -clock [get_clocks {clk}] -add_delay [get_ports {req_write}]
set_output_delay 1.0000 -clock [get_clocks {clk}] -add_delay [get_ports {resp_valid}]
